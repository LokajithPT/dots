-- =========================
-- Transparency Logic (The Fix)
-- =========================
local M = {}
local original_scheme = "moonfly"
M.toggle = true 

M.transparency_on = function() 
    local groups = {
        "Normal", "NormalNC", "VertSplit", "StatusLine", "StatusLineNC",
        "Pmenu", "TelescopeNormal", "TelescopeBorder", "NvimTreeNormal",
        "Terminal", "ToggleTerm", "SignColumn", "LineNr", "CursorLineNr",
        "EndOfBuffer", "MsgArea", "NormalFloat", "FloatBorder" , "ZenBg"
    }
    for _, group in ipairs(groups) do
        vim.api.nvim_set_hl(0, group, { bg = "NONE", ctermbg = "NONE" })
    end
end

vim.api.nvim_create_autocmd("ColorScheme", {
    callback = function()
        if M.toggle then M.transparency_on() end
    end,
})

vim.api.nvim_create_user_command("TransToggle", function() 
    M.toggle = not M.toggle
    if M.toggle then 
        M.transparency_on()
        print("Transparency ON")
    else 
        vim.cmd("colorscheme " .. original_scheme)
        print("Transparency OFF")
    end
end, {})

-- =========================
-- Additional Key Mappings
-- =========================
local opts = { noremap=true, silent=true }
vim.keymap.set("n", "<C-n>", ":NvimTreeToggle<CR>", opts)
vim.keymap.set("n", "<leader>tt", ":TransToggle<CR>", opts)
vim.keymap.set("n", "f", ":HopChar1<CR>", opts)
vim.keymap.set("n", "F", ":HopWord<CR>", opts)
vim.keymap.set("n", "<C-p>", function() require("telescope.builtin").find_files() end, opts)
vim.keymap.set("n", "<C-b>", function() require("telescope.builtin").buffers() end, opts)
vim.keymap.set("n", "<leader>g", function() require("telescope.builtin").live_grep() end, opts)
vim.keymap.set("n", "<leader>p", ":Telescope commands<CR>", opts)
vim.keymap.set("n", "<leader>cs", function() require("telescope.builtin").lsp_document_symbols() end, opts)
vim.keymap.set("n", "<leader>cr", function() require("telescope.builtin").lsp_references() end, opts)
local function goto_first()
  local handler = function(err, result, ctx)
    if err then return end
    if type(result) ~= "table" or vim.tbl_isempty(result) then
      vim.notify("No definition found", vim.log.levels.WARN)
      return
    end
    local client = vim.lsp.get_client_by_id(ctx.client_id)
    local offset_encoding = client and client.offset_encoding or "utf-16"
    local loc = result[1]
    if type(loc) == "table" and loc.targetUri then
      loc = { uri = loc.targetUri, range = loc.targetRange }
    end
    vim.lsp.util.jump_to_location(loc, offset_encoding)
  end
  vim.lsp.buf_request(0, "textDocument/definition", vim.lsp.util.make_position_params(), handler)
end
vim.keymap.set("n", "gd", goto_first, opts)
vim.keymap.set("n", "gD", goto_first, opts)
vim.keymap.set("n", "<C-o>", "<C-o>", opts)
vim.keymap.set("n", "<leader>z", ":ZenMode<CR>", opts)
vim.keymap.set("n", "<C-f>", "<Cmd>BufferLineCycleNext<CR>", opts)
vim.keymap.set("n", "<C-Tab>", "<Cmd>BufferLineCycleNext<CR>", opts)
vim.keymap.set("n", "<C-S-Tab>", "<Cmd>BufferLineCyclePrev<CR>", opts)
vim.keymap.set("n", "<leader>t", "<Cmd>BufferLinePick<CR>", opts)
vim.keymap.set("n", "<leader>bd", function() require("mini.bufremove").delete(0, false) end, opts)
vim.keymap.set("n", "<C-w>w", function() require("mini.bufremove").delete(0, false) end, opts)

-- =========================
-- File Monitoring & Autocmds
-- =========================
vim.opt.autoread = true

vim.api.nvim_create_autocmd({ "FocusGained", "BufEnter", "CursorHold", "CursorHoldI" }, {
    callback = function()
        if vim.fn.getcmdwintype() == '' then
            vim.cmd('checktime')
        end
    end,
})

vim.api.nvim_create_autocmd("FileChangedShellPost", {
    callback = function()
        vim.api.nvim_echo({ { "File changed on disk. Buffer reloaded.", "WarningMsg" } }, true, {})
    end,
})

-- Force Rust local buffer sizing
vim.api.nvim_create_autocmd("FileType", {
  pattern = "rust",
  callback = function()
    vim.opt_local.shiftwidth = 2
    vim.opt_local.tabstop = 2
    vim.opt_local.softtabstop = 2
  end,
})

-- Set fallback commentstrings for languages where Neovim leaves it empty
vim.api.nvim_create_autocmd("FileType", {
  pattern = { "c", "cpp", "rust", "go" },
  callback = function()
    vim.bo.commentstring = "// %s"
  end,
})

vim.opt.updatetime = 300 
vim.opt.swapfile = false

-- =========================
-- Initialization
-- =========================
vim.cmd("colorscheme moonfly")

-- Diagnostics setup configuration parameters
vim.diagnostic.config({
  underline = false,
  virtual_text = {
    severity = { min = vim.diagnostic.severity.WARN },
  },
  signs = true,
})

vim.schedule(function()
    if M.toggle then
        M.transparency_on()
    end
end)
